# Supabase
# Copy this file to .env.local and fill in your values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# n8n automation
# Per-service n8n trigger URLs are stored in the services table
# (services.webhook_url), NOT here — repointing a service is a pure database
# change and needs no redeploy. See the SQL in supabase/schema.sql.
#
# Shared secret the app sends to n8n AND that n8n must send back on the
# callback (header: x-webhook-auth-token). Keep this value ONLY in Vercel /
# .env.local — never commit a real token to this file.
N8N_WEBHOOK_AUTH_TOKEN=

# Domain / WHOIS Bulk Monitor
# The workflow URL is NOT an env var — it is read per request from
# services.webhook_url where services.key = 'domain-monitor'.
# This secret is sent server-side only, as the `x-api-token` header.
DOMAIN_MONITOR_TOKEN=

# Voice support widget ("Aura") — server-side only, never NEXT_PUBLIC.
# The browser calls /api/voice, which forwards the audio to this n8n webhook.
N8N_VOICE_WEBHOOK_URL=
# Header name used for the shared secret (defaults to x-voice-secret).
N8N_VOICE_HEADER_NAME=
N8N_VOICE_SECRET=